{
  "name": "scaffy-temp",
  "version": "2.0.0",
  "description": "A CLI tool to scaffold project templates with composable wrappers",
  "bin": {
    "scaffy-temp": "./dist/src/cli.js",
    "cfs": "./dist/src/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "postbuild": "chmod +x dist/src/cli.js dist/cli/index.js"
  },
  "keywords": [
    "scaffolding",
    "template",
    "folder-structure",
    "cli",
    "boilerplate",
    "generator",
    "wrappers"
  ],
  "author": {
    "name": "Darsh Gajdhar",
    "email": "darsh2126gajdhar@gmail.com",
    "url": "https://github.com/Darsh2126"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darsh2126/folder-structures.git"
  },
  "bugs": {
    "url": "https://github.com/Darsh2126/folder-structures/issues"
  },
  "homepage": "https://github.com/Darsh2126/folder-structures#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.1.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
