{
  "tag": "drizzle",
  "label": "Drizzle ORM Wrapper",
  "targets": ["nextjs-app-router", "nextjs-pages-router", "node-express", "node-nestjs"],
  "injects_into": "src/wrappers/drizzle/",
  "root_files": ["drizzle.config.ts"],
